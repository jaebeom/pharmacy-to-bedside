<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>rokey_p3_navigation</name>
  <version>0.0.0</version>
  <description>occupancy map, Nav2, keepout 마스크, 도킹, 대기 열 이동. navigation 담당.</description>
  <maintainer email="l.jaebeom@gmail.com">JAEBEOM LIM</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>rokey_p3_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-yaml</depend>

  <!-- zones.yaml 은 rokey_p3_description/config/zones.yaml 하나다 (계약 3절, simulation 소유). -->
  <exec_depend>rokey_p3_description</exec_depend>

  <!-- launch: Nav2 + AMCL + map_server. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
