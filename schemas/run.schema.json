{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaebeom/ROKEY_P3_A3/schemas/run.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-master0[12]-[a-f0-9]{8}$(?![\\s\\S])"
    },
    "phase": {
      "enum": [
        "pilot",
        "acceptance"
      ]
    },
    "not_applicable": {
      "type": "object",
      "properties": {
        "not_applicable": {
          "type": "string",
          "minLength": 10,
          "pattern": "\\S"
        }
      },
      "required": [
        "not_applicable"
      ],
      "additionalProperties": false
    },
    "version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*(?:latest|unknown|tbd|TBD|\\*|[<>~^])).*\\S.*$(?![\\s\\S])"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "code": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_patch_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false
    },
    "host_id": {
      "enum": [
        "master01",
        "master02"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "object",
          "properties": {
            "os": {
              "$ref": "#/$defs/version"
            },
            "ros": {
              "$ref": "#/$defs/version"
            },
            "isaac_sim": {
              "$ref": "#/$defs/version"
            },
            "rmw": {
              "$ref": "#/$defs/version"
            },
            "gpu_driver": {
              "$ref": "#/$defs/version"
            },
            "cuda": {
              "$ref": "#/$defs/version"
            }
          },
          "required": [
            "os",
            "ros",
            "isaac_sim",
            "rmw",
            "gpu_driver",
            "cuda"
          ],
          "additionalProperties": false
        },
        "fingerprints": {
          "type": "object",
          "properties": {
            "config": {
              "$ref": "#/$defs/fingerprint"
            },
            "scene": {
              "$ref": "#/$defs/fingerprint"
            },
            "model": {
              "$ref": "#/$defs/fingerprint"
            },
            "dataset": {
              "$ref": "#/$defs/fingerprint"
            }
          },
          "required": [
            "config",
            "scene",
            "model",
            "dataset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "versions",
        "fingerprints"
      ],
      "additionalProperties": false
    },
    "clocks": {
      "type": "object",
      "properties": {
        "duration": {
          "enum": [
            "simulation",
            "monotonic"
          ],
          "description": "Primary duration clock. Each timed metric uses its own clock declared in the referenced protocol."
        },
        "timeout": {
          "enum": [
            "monotonic"
          ]
        }
      },
      "required": [
        "duration",
        "timeout"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "repetition_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "protocol": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^experiments/protocols/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.json$(?![\\s\\S])"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "aborted",
        "timeout"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "uri",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "pattern": "\\S",
            "minLength": 1
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "sample_count",
          "missing_count"
        ],
        "additionalProperties": false
      }
    },
    "supersedes": {
      "$ref": "#/$defs/run_id"
    },
    "notes": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "correction_reason": {
      "type": "string",
      "minLength": 10
    },
    "failure_class": {
      "enum": [
        "robot",
        "infra",
        "operator"
      ]
    },
    "failure_cause": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "failure_evidence": {
      "type": "string",
      "pattern": "\\S",
      "minLength": 1
    },
    "retry_run_id": {
      "$ref": "#/$defs/run_id"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "code",
    "host_id",
    "environment",
    "clocks",
    "seed",
    "repetition_index",
    "protocol",
    "phase",
    "outcome",
    "artifacts",
    "metrics"
  ],
  "additionalProperties": false
}
